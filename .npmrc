; @whitecapgeospatial/* is published to GitHub Packages, not npmjs.com.
; NODE_AUTH_TOKEN must carry `read:packages`. Locally:
;   NODE_AUTH_TOKEN=$(gh auth token) bun install
; In CI it comes from the NPM_GITHUB_TOKEN repo secret (see .github/workflows/deploy.yml).
@whitecapgeospatial:registry=https://npm.pkg.github.com
//npm.pkg.github.com/:_authToken=${NODE_AUTH_TOKEN}
